---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import PptxSlideshow from '../../components/PptxSlideshow.astro';
import PaperFigures from '../../components/PaperFigures.astro';
import VideoPlayer from '../../components/VideoPlayer.astro';
import publications from '../../data/publications.json';

export function getStaticPaths() {
  return publications.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const chartAccent = 'violet';
const accentText = 'text-violet-400';
const accentBorder = 'hover:border-violet-400/40';
const glow = 'from-violet-500/15 via-transparent to-transparent';
---

<BaseLayout
  title={paper.shortTitle}
  description={paper.abstract}
  keywords={`${paper.paperId}, ${paper.shortTitle}, SPE, AI agents, process safety, published research`}
  publishedDate="2026-11-02"
  articleSection="Research"
  articleTags={paper.tags.map((t) => t.label)}
>
  <article class="pt-20 pb-16">
    <!-- Hero band -->
    <header class={`relative overflow-hidden border-b border-border bg-gradient-to-b ${glow}`}>
      <div class="absolute inset-0 opacity-[0.35]" style="background-image:radial-gradient(circle at 1px 1px, rgba(139,148,158,0.18) 1px, transparent 0); background-size:22px 22px"></div>
      <div class="container-main max-w-5xl relative py-10 sm:py-14">
        <a href="/#research" class={`inline-flex items-center gap-1.5 text-xs font-mono ${accentText} hover:opacity-80 transition-opacity mb-6`}>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Published Research
        </a>

        <div class="flex flex-wrap items-center gap-2 mb-5">
          <span class="text-[10px] font-mono text-secondary">{paper.venue}</span>
          <span class="text-[10px] font-mono text-secondary">{paper.paperId}</span>
          <span class="text-[10px] font-mono text-green sm:ml-auto">{paper.role}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-bold text-foreground leading-[1.15] tracking-tight max-w-4xl mb-4">
          {paper.title}
        </h1>

        <p class={`text-lg sm:text-2xl font-medium leading-snug mb-5 ${accentText}`}>
          {paper.hook}
        </p>

        <div class="max-w-3xl mb-2">
          <p class="text-sm text-secondary leading-relaxed">
            {paper.authorList.map((a, i) => (
              <>
                {i > 0 && <span>, </span>}
                <span class="whitespace-nowrap text-foreground/90">
                  {a.name}<sup class={`text-[10px] ${accentText}`}>{a.aff}</sup>
                </span>
              </>
            ))}
          </p>
          <ul class="mt-2 space-y-0.5">
            {paper.affiliationList.map((aff) => (
              <li class="text-[11px] text-secondary/80 leading-snug">
                <span class={`font-mono ${accentText}`}>{aff.id}</span> {aff.label}
              </li>
            ))}
          </ul>
          <p class="text-[10px] font-mono text-secondary/60 mt-2">DOI {paper.doi}</p>
        </div>

        <div class="flex flex-wrap items-center gap-3 mt-6 mb-6">
          <a href={paper.onepetro} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm">
            Read on OnePetro
          </a>
          <a href="#explainer" data-play-explainer class="btn btn-secondary text-sm inline-flex items-center gap-2">
            <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            Play explainer
          </a>
          <a href="#slides" class="btn btn-secondary text-sm">
            View slides
          </a>
          <button
            type="button"
            class="btn btn-secondary text-sm inline-flex items-center gap-2"
            data-cite-btn
            data-citation={paper.citation}
            aria-label="Copy citation"
          >
            <svg data-cite-icon class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            <svg data-cite-check class="w-3.5 h-3.5 hidden text-green" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <span data-cite-label>Cite</span>
          </button>
        </div>

        <!-- Jump nav -->
        <nav class="flex flex-wrap gap-2 text-[11px] font-mono">
          {[
            ['#summary', 'Summary'],
            ['#results', 'Results'],
            ['#explainer', 'Explainer'],
            ['#pipeline', 'Pipeline'],
            ['#viz', 'Figures'],
            ['#findings', 'Findings'],
            ['#slides', 'Slides'],
          ].map(([href, label]) => (
            <a href={href} class={`px-2.5 py-1 rounded-md border border-border bg-elevated/80 text-secondary ${accentBorder} hover:text-foreground transition-colors`}>{label}</a>
          ))}
        </nav>
      </div>
    </header>

    <div class="container-main max-w-5xl pt-10">
      <!-- Summary + headline metrics -->
      <section id="summary" class="mb-14">
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">
          <div class="lg:col-span-3 p-6 rounded-2xl border border-border bg-elevated">
            <p class="text-[10px] font-mono text-green mb-3">// Summary</p>
            <p class="text-base text-foreground/95 leading-relaxed mb-4">{paper.summary}</p>
            <p class="text-sm text-secondary leading-relaxed">{paper.abstract}</p>
          </div>
          <div id="results" class="lg:col-span-2 grid grid-cols-2 gap-3 content-start">
            {paper.results.map((r) => (
              <div class={`p-4 rounded-2xl border border-border bg-elevated ${accentBorder} transition-colors`}>
                <p class={`font-mono text-2xl font-bold mb-1.5 ${accentText}`}>{r.value}</p>
                <p class="text-[11px] text-secondary leading-snug">{r.label}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Video -->
      <section class="mb-14" id="explainer">
        <p class="text-[10px] font-mono text-green mb-3">// Explainer video</p>
        {paper.video.status === 'ready' && paper.video.src ? (
          <VideoPlayer src={paper.video.src} title={paper.video.title} />
        ) : (
          <div class="relative rounded-2xl border border-dashed border-border bg-elevated/50 overflow-hidden aspect-video flex flex-col items-center justify-center gap-3 px-6 text-center">
            <div class="w-14 h-14 rounded-full border border-border bg-background/80 flex items-center justify-center">
              <svg class="w-6 h-6 text-secondary" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </div>
            <div>
              <p class="text-sm font-medium text-foreground mb-1">{paper.video.title}</p>
              <p class="text-xs text-secondary max-w-md mx-auto leading-relaxed">{paper.video.note}</p>
            </div>
            <span class="text-[10px] font-mono text-secondary/60 px-2 py-0.5 rounded border border-border">Coming soon</span>
          </div>
        )}
      </section>

      <!-- Pipeline -->
      {paper.pipeline && (
        <section id="pipeline" class="mb-14">
          <p class="text-[10px] font-mono text-green mb-4">// How it works</p>
          <div class="relative grid grid-cols-1 sm:grid-cols-4 gap-3">
            {paper.pipeline.map((step, i) => (
              <div class="relative p-4 rounded-2xl border border-border bg-elevated">
                <div class="flex items-center gap-2 mb-2">
                  <span class={`w-6 h-6 rounded-full border border-border flex items-center justify-center text-[10px] font-mono ${accentText}`}>{i + 1}</span>
                  <p class="text-sm font-semibold text-foreground">{step.step}</p>
                </div>
                <p class="text-[12px] text-secondary leading-relaxed">{step.detail}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Problem / Approach -->
      <section class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-14">
        <div class="p-5 rounded-2xl border border-border bg-elevated">
          <p class="text-[10px] font-mono text-green mb-2">// Problem</p>
          <p class="text-sm text-secondary leading-relaxed">{paper.problem}</p>
        </div>
        <div class="p-5 rounded-2xl border border-border bg-elevated">
          <p class="text-[10px] font-mono text-green mb-2">// Approach</p>
          <p class="text-sm text-secondary leading-relaxed">{paper.approach}</p>
        </div>
      </section>

      <!-- Contributions + method -->
      <section class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-14">
        <div>
          <p class="text-[10px] font-mono text-green mb-3">// Notable contributions</p>
          <ul class="space-y-2">
            {paper.contributions.map((c) => (
              <li class="flex gap-3 p-3.5 rounded-xl border border-border bg-elevated">
                <span class={`${accentText} font-mono text-xs shrink-0 mt-0.5`}>▹</span>
                <span class="text-sm text-secondary leading-relaxed">{c}</span>
              </li>
            ))}
          </ul>
        </div>
        <div>
          <p class="text-[10px] font-mono text-green mb-3">// Method</p>
          <div class="space-y-2">
            {paper.method.map((m) => (
              <div class="px-3.5 py-2.5 rounded-xl border border-border bg-elevated text-xs text-secondary leading-relaxed">
                {m}
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Paper figures -->
      <section id="viz" class="mb-14">
        <div class="mb-6 max-w-2xl">
          <p class="text-[10px] font-mono text-green mb-2">// Figures from the paper</p>
          <h2 class="text-xl sm:text-2xl font-bold text-foreground mb-2">Graphs as published</h2>
          <p class="text-sm text-secondary leading-relaxed">
            Exact figures extracted from the SPE manuscript - architecture, heatmaps, completion, wall time, and the rest. Click any figure to enlarge.
          </p>
        </div>
        <PaperFigures figures={paper.figures as any} accent={chartAccent} />
      </section>

      <!-- Findings -->
      <section id="findings" class="mb-14">
        <p class="text-[10px] font-mono text-green mb-4">// Key findings</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {paper.findings.map((f, i) => (
            <div class="flex gap-3 p-4 rounded-2xl border border-border bg-elevated h-full">
              <span class={`font-mono text-[11px] ${accentText} shrink-0`}>{String(i + 1).padStart(2, '0')}</span>
              <p class="text-sm text-secondary leading-relaxed">{f}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Concepts -->
      <section class="mb-14">
        <p class="text-[10px] font-mono text-green mb-3">// Concepts</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          {paper.tags.map((tag) => (
            <div class="p-3 rounded-xl border border-border bg-elevated">
              <p class={`text-xs font-mono font-semibold mb-1 ${accentText}`}>{tag.label}</p>
              <p class="text-[11px] text-secondary leading-snug">{tag.detail}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Slideshow -->
      <section id="slides" class="mb-12">
        <PptxSlideshow src={paper.slides} title={paper.shortTitle} slideCount={paper.slideCount} />
      </section>

      <div class="flex flex-wrap items-end justify-between gap-4 mb-10">
        <div class="flex flex-wrap items-center gap-3">
          <a href={paper.onepetro} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-sm">
            Read on OnePetro
          </a>
        </div>
        <img
          src="/research/adipec-adnoc-white.png?v=2"
          alt="ADIPEC · ADNOC Host"
          class="h-12 sm:h-14 w-auto opacity-95 shrink-0"
          loading="lazy"
          decoding="async"
        />
      </div>

      <ShareButtons url={`/research/${paper.slug}`} title={paper.title} />
    </div>
  </article>

  <script>
    // Land at the top of the paper page (slideshow focus used to pull scroll down)
    if (!window.location.hash) {
      window.scrollTo(0, 0);
    }

    function wireCite() {
      document.querySelectorAll<HTMLButtonElement>('[data-cite-btn]').forEach((btn) => {
        if (btn.dataset.wired === '1') return;
        btn.dataset.wired = '1';
        btn.addEventListener('click', async () => {
          const text = btn.dataset.citation || '';
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          const icon = btn.querySelector('[data-cite-icon]');
          const check = btn.querySelector('[data-cite-check]');
          const label = btn.querySelector('[data-cite-label]');
          icon?.classList.add('hidden');
          check?.classList.remove('hidden');
          if (label) label.textContent = 'Copied';
          setTimeout(() => {
            icon?.classList.remove('hidden');
            check?.classList.add('hidden');
            if (label) label.textContent = 'Cite';
          }, 1800);
        });
      });
    }
    wireCite();
    document.addEventListener('astro:page-load', wireCite);
  </script>
</BaseLayout>
