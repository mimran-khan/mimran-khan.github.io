<script is:inline>
(function() {
  document.querySelectorAll('.media-player').forEach(player => {
    const slides = player.querySelectorAll('.media-slide');
    const label = player.querySelector('.player-label');
    const dotsContainer = player.querySelector('.player-dots');
    const banner = player.querySelector('.sensitive-banner');
    const prevBtn = player.querySelector('.nav-prev');
    const nextBtn = player.querySelector('.nav-next');
    if (!slides.length) return;

    if (player.querySelector('.is-sensitive') && banner) banner.classList.remove('hidden');

    slides.forEach((_, i) => {
      if (!dotsContainer) return;
      const dot = document.createElement('button');
      dot.className = 'player-dot w-2 h-2 rounded-full transition-all duration-300 ' + (i === 0 ? 'bg-white w-5' : 'bg-white/30');
      if (slides[i].dataset.sensitive === 'true') dot.classList.add('ring-1', 'ring-amber-500/50');
      dot.dataset.index = i;
      dotsContainer.appendChild(dot);
    });
    const dots = dotsContainer ? dotsContainer.querySelectorAll('.player-dot') : [];

    let current = 0;

    function pauseAll() {
      slides.forEach(s => { const v = s.querySelector('video'); if (v) { v.pause(); v.currentTime = 0; } });
    }

    function show(idx) {
      pauseAll();
      current = ((idx % slides.length) + slides.length) % slides.length;
      slides.forEach((s, i) => { s.classList.toggle('opacity-100', i === current); s.classList.toggle('opacity-0', i !== current); });
      dots.forEach((d, i) => { d.classList.toggle('bg-white', i === current); d.classList.toggle('w-5', i === current); d.classList.toggle('bg-white/30', i !== current); d.classList.toggle('w-2', i !== current); });
      if (label) label.textContent = slides[current].dataset.label;
      const active = slides[current];
      if (active.dataset.type === 'video' && (!active.classList.contains('is-sensitive') || active.classList.contains('revealed'))) {
        const v = active.querySelector('video'); if (v) v.play().catch(() => {});
      }
    }

    let auto = null;
    if (slides.length > 1) {
      auto = setInterval(() => { show((current + 1) % slides.length); }, 4500);
    }
    const restart = () => { if (auto) clearInterval(auto); if (slides.length > 1) auto = setInterval(() => show((current + 1) % slides.length), 4500); };

    dots.forEach((d, i) => d.addEventListener('click', () => { show(i); restart(); }));
    if (prevBtn) prevBtn.addEventListener('click', () => { show(current - 1); restart(); });
    if (nextBtn) nextBtn.addEventListener('click', () => { show(current + 1); restart(); });

    player.addEventListener('mouseenter', () => { if (prevBtn) prevBtn.style.opacity = '1'; if (nextBtn) nextBtn.style.opacity = '1'; });
    player.addEventListener('mouseleave', () => { if (prevBtn) prevBtn.style.opacity = '0'; if (nextBtn) nextBtn.style.opacity = '0'; });

    player.querySelectorAll('.eye-toggle').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const slide = btn.closest('.media-slide');
        const overlay = slide.querySelector('.blur-overlay');
        if (slide.classList.contains('revealed')) {
          slide.classList.remove('revealed'); slide.classList.add('is-sensitive');
          if (overlay) overlay.style.opacity = '1';
          btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>';
          const v = slide.querySelector('video'); if (v) { v.pause(); v.currentTime = 0; }
        } else {
          slide.classList.add('revealed'); slide.classList.remove('is-sensitive');
          if (overlay) overlay.style.opacity = '0';
          btn.innerHTML = '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21"/></svg>';
          if (slide.dataset.type === 'video') { const v = slide.querySelector('video'); if (v) v.play().catch(() => {}); }
        }
      });
    });
  });
})();
</script>

<style is:global>
  .blur-overlay { position:absolute; inset:0; backdrop-filter:blur(30px); -webkit-backdrop-filter:blur(30px); background:rgba(0,0,0,0.3); transition:opacity 0.4s ease; z-index:5; }
  .eye-toggle { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); z-index:10; background:rgba(0,0,0,0.6); border:1px solid rgba(245,158,11,0.4); color:#f59e0b; width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all 0.2s; }
  .eye-toggle:hover { background:rgba(0,0,0,0.8); border-color:#f59e0b; transform:translate(-50%,-50%) scale(1.1); }
  .media-slide video { background:black; }
  @keyframes float-1 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(8px,-12px)} 50%{transform:translate(-6px,-8px)} 75%{transform:translate(10px,6px)} }
  @keyframes float-2 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(-10px,8px)} 50%{transform:translate(6px,14px)} 75%{transform:translate(-8px,-6px)} }
  @keyframes float-3 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(12px,6px)} 50%{transform:translate(-4px,-10px)} 75%{transform:translate(-10px,8px)} }
  @keyframes float-4 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(-6px,-10px)} 50%{transform:translate(10px,-4px)} 75%{transform:translate(4px,12px)} }
  @keyframes float-5 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(8px,10px)} 50%{transform:translate(-12px,6px)} 75%{transform:translate(6px,-8px)} }
  @keyframes float-6 { 0%,100%{transform:translate(0,0)} 25%{transform:translate(-8px,6px)} 50%{transform:translate(10px,-8px)} 75%{transform:translate(-4px,10px)} }
  .hero-bubble { will-change:transform; }
</style>
