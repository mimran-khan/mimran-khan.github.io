    <!-- Quote -->
    <div class="border-y border-border py-12 md:py-16">
      <blockquote class="text-xl md:text-2xl text-foreground font-medium leading-relaxed max-w-3xl">"The greatness of a nation and its moral progress can be judged by the way its animals are treated."</blockquote>
      <p class="text-sm text-secondary mt-4">— Mahatma Gandhi</p>
