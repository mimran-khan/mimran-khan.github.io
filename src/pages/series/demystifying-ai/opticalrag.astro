---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import NextEpisodeTeaser from '../../../components/NextEpisodeTeaser.astro';
---

<BaseLayout
  title="OpticalRAG: RAG in 16 Visual Tokens | Demystifying AI in 5 Minutes"
  description="OpticalRAG renders documents as page images and distills retrieval into 16 query-conditioned tokens - winning compression-aware accuracy on LongBench-v2."
  image="/og-series-ep59-opticalrag.png"
  keywords="OpticalRAG, pixel-space RAG, visual tokens, LongBench-v2, CAP, NeurIPS 2026, arXiv 2611.13675, Qwen2.5, DeepEncoder, Encoder-Bridged Retrieval, Query-Driven Distillation"
  publishedDate="2026-11-18"
  articleSection="Demystifying AI"
  articleTags={["OpticalRAG", "RAG", "Visual Tokens", "LongBench-v2", "NeurIPS 2026", "arXiv"]}
>

  <style>
    .stat-card { transition: all 0.3s ease; }
    .stat-card:hover { transform: scale(1.02); box-shadow: 0 0 20px rgba(139, 92, 246, 0.15); }
    .viz-card { transition: all 0.3s ease; }
    .viz-card:hover { transform: translateY(-2px); box-shadow: 0 0 16px rgba(139, 92, 246, 0.12); }
    .bar-fill { transition: width 0.6s ease; }
  </style>

  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-violet-500/[0.04] via-background to-background"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.06)_0%,transparent_60%)]"></div>

    <div class="relative container-main max-w-4xl pt-20 pb-10">
      <a href="/series/demystifying-ai" class="inline-flex items-center gap-2 text-xs text-secondary hover:text-violet-400 transition-colors mb-8 font-mono">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        cd ~/series/demystifying-ai
      </a>

      <div class="rounded-xl overflow-hidden border border-border mb-8">
        <img src="/series/ep59-opticalrag.png" alt="OpticalRAG: RAG in 16 Visual Tokens" class="w-full h-auto block" />
      </div>

      <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-4">
        <span class="flex items-center gap-1.5 text-[10px] text-violet-400 font-mono bg-violet-500/5 border border-violet-500/20 px-2 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-violet-400 animate-pulse"></span>
          EP 59
        </span>
        <a href="https://arxiv.org/abs/2611.13675" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-2.5 py-1 text-[10px] font-mono bg-violet-500/10 border border-violet-500/20 text-violet-400 rounded-full hover:bg-violet-500/20 hover:border-violet-500/40 transition-colors">
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="4" y="2" width="16" height="20" rx="2" /><path d="M9 7l3 5-3 5M15 7l-3 5 3 5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          arXiv: 2611.13675
          <svg class="w-2.5 h-2.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <span class="text-[10px] text-secondary font-mono">Nov 18, 2026</span>
        <span class="text-[10px] text-secondary font-mono">5 min</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">
        OpticalRAG: RAG in 16 Visual Tokens
      </h1>
      <p class="text-sm md:text-base text-secondary max-w-2xl mb-2">
        Pixel-space compression for retrieval. Render the page, keep 16 query-conditioned tokens, beat text compressors on LongBench-v2.
      </p>

      <ShareButtons title="OpticalRAG: RAG in 16 Visual Tokens" url="/series/demystifying-ai/opticalrag" />
    </div>
  </section>

  <article class="container-main max-w-4xl py-8 md:py-10 overflow-hidden">

    <!-- TL;DR -->
    <div class="rounded-xl border border-violet-500/20 bg-violet-500/[0.03] p-4 md:p-6 mb-8 md:mb-10 max-w-3xl">
      <span class="text-xs font-mono text-violet-400 font-bold">// TL;DR</span>
      <p class="text-sm text-foreground/90 leading-relaxed mt-3 mb-0">
        <strong>OpticalRAG</strong> (Liu et al., NeurIPS 2026 / arXiv:2611.13675) argues the RAG bottleneck is the <strong>compression modality</strong>, not raw information density. It renders docs as page images, encodes with a frozen ViT, retrieves via <strong>Encoder-Bridged Retrieval</strong> (no contrastive training), then <strong>Query-Driven Distillation</strong> packs the hit into <strong>16</strong> prefix tokens for frozen Qwen2.5-7B-Instruct. LongBench-v2: <strong>35.79</strong> vs closed-book <strong>30.62</strong> (<strong>+5.17</strong>). Best CAP on all three benches.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-8 md:mb-10 max-w-3xl">
      <div class="rounded-xl border border-violet-500/20 bg-violet-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-violet-400 mb-1">16</div>
        <div class="text-[10px] font-mono text-secondary">Prefix tokens</div>
      </div>
      <div class="rounded-xl border border-violet-500/20 bg-violet-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-violet-400 mb-1">+5.17</div>
        <div class="text-[10px] font-mono text-secondary">LongBench-v2 lift</div>
      </div>
      <div class="rounded-xl border border-violet-500/20 bg-violet-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-violet-400 mb-1">55.67</div>
        <div class="text-[10px] font-mono text-secondary">Avg CAP (best)</div>
      </div>
      <div class="rounded-xl border border-violet-500/20 bg-violet-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-violet-400 mb-1">0</div>
        <div class="text-[10px] font-mono text-secondary">Contrastive pretrain</div>
      </div>
    </div>

    <!-- Problem: modality bottleneck -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-violet-400 font-mono text-sm">#</span> The Bottleneck Is the Modality
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        Feeding long docs into the LLM is expensive. Aggressive <strong>text</strong> compression throws away layout, tables, and fine detail that a 1D token stream cannot keep. OpticalRAG says that is a <strong>modality choice</strong>, not a hard information limit.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-3">TEXT COMPRESSION PATH</div>
          <div class="flex flex-col gap-2 mb-3">
            <div class="rounded-lg border border-border bg-[#161b22] px-3 py-2 text-[10px] font-mono text-foreground/70">PDF / pages</div>
            <div class="text-center text-[10px] text-secondary">↓ OCR / chunk</div>
            <div class="rounded-lg border border-border bg-[#161b22] px-3 py-2 text-[10px] font-mono text-foreground/70">1D token stream</div>
            <div class="text-center text-[10px] text-secondary">↓ prune / summarize</div>
            <div class="rounded-lg border border-yellow-500/30 bg-yellow-500/[0.04] px-3 py-2 text-[10px] font-mono text-yellow-400">Hundreds of tokens · layout gone</div>
          </div>
          <p class="text-[10px] text-secondary mb-0">Once structure is flattened to text, compressors cannot recover tables and figures cleanly.</p>
        </div>
        <div class="rounded-xl border border-violet-500/30 bg-violet-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-violet-400 font-bold mb-3">PIXEL COMPRESSION PATH</div>
          <div class="flex flex-col gap-2 mb-3">
            <div class="rounded-lg border border-violet-500/20 bg-[#161b22] px-3 py-2 text-[10px] font-mono text-foreground/70">PDF / pages</div>
            <div class="text-center text-[10px] text-violet-400">↓ render images</div>
            <div class="rounded-lg border border-violet-500/20 bg-[#161b22] px-3 py-2 text-[10px] font-mono text-foreground/70">Frozen ViT (~100 visual toks / page)</div>
            <div class="text-center text-[10px] text-violet-400">↓ query distill</div>
            <div class="rounded-lg border border-violet-500/40 bg-violet-500/10 px-3 py-2 text-[10px] font-mono text-violet-400 font-bold">16 prefix tokens · layout kept</div>
          </div>
          <p class="text-[10px] text-secondary mb-0">Modern visual encoders pack a rendered page with little semantic loss - a tradeoff text alone cannot match.</p>
        </div>
      </div>
    </div>

    <!-- Classic vs OpticalRAG -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-violet-400 font-mono text-sm">#</span> Classic RAG vs OpticalRAG
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        Same job: retrieve evidence, answer with an LLM. Different thing stuffed into the prompt.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-2">
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-3">CLASSIC TEXT RAG</div>
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-secondary/20 flex items-center justify-center text-[9px] font-mono text-secondary shrink-0">1</span>
              <span class="text-[11px] text-foreground/80">Embed query in text space</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-secondary/20 flex items-center justify-center text-[9px] font-mono text-secondary shrink-0">2</span>
              <span class="text-[11px] text-foreground/80">Retrieve text chunks</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-secondary/20 flex items-center justify-center text-[9px] font-mono text-secondary shrink-0">3</span>
              <span class="text-[11px] text-foreground/80">Paste chunks into context</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-secondary/20 flex items-center justify-center text-[9px] font-mono text-secondary shrink-0">4</span>
              <span class="text-[11px] text-foreground/80">LLM answers on a fat prompt</span>
            </div>
          </div>
        </div>
        <div class="rounded-xl border border-violet-500/30 bg-violet-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-violet-400 font-bold mb-3">OPTICALRAG</div>
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-violet-500/20 flex items-center justify-center text-[9px] font-mono text-violet-400 shrink-0">1</span>
              <span class="text-[11px] text-foreground/80">Render docs → page images</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-violet-500/20 flex items-center justify-center text-[9px] font-mono text-violet-400 shrink-0">2</span>
              <span class="text-[11px] text-foreground/80">Bridge query into visual space</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-violet-500/20 flex items-center justify-center text-[9px] font-mono text-violet-400 shrink-0">3</span>
              <span class="text-[11px] text-foreground/80">Distill retrieved visuals → 16 toks</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-violet-500/20 flex items-center justify-center text-[9px] font-mono text-violet-400 shrink-0">4</span>
              <span class="text-[11px] text-foreground/80">LLM answers on a tiny prefix</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Full architecture -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-violet-400 font-mono text-sm">#</span> System Architecture
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        Five stages. Two frozen giants. One small trainable middle.
      </p>

      <!-- Desktop architecture flow -->
      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5 mb-5">
        <div class="text-[10px] font-mono text-secondary mb-4">END-TO-END FLOW</div>

        <div class="hidden md:block space-y-3">
          <!-- Row: corpus -->
          <div class="flex items-stretch gap-2">
            <div class="w-28 shrink-0 flex items-center">
              <span class="text-[10px] font-mono text-secondary">CORPUS</span>
            </div>
            <div class="flex-1 grid grid-cols-3 gap-2">
              <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
                <div class="text-[10px] font-bold text-foreground mb-1">Docs</div>
                <div class="text-[9px] text-secondary">PDF / HTML / pages</div>
              </div>
              <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center flex flex-col justify-center">
                <div class="text-[9px] text-violet-400 font-mono mb-1">render →</div>
                <div class="text-[10px] font-bold text-foreground">Page images</div>
              </div>
              <div class="rounded-lg border border-yellow-500/25 bg-yellow-500/[0.04] p-3 text-center">
                <div class="text-[9px] font-mono text-yellow-400 mb-1">FROZEN</div>
                <div class="text-[10px] font-bold text-foreground">DeepEncoder ViT</div>
                <div class="text-[9px] text-secondary mt-1">~100 visual toks / page</div>
              </div>
            </div>
          </div>

          <div class="flex justify-center">
            <div class="text-[10px] font-mono text-violet-400">↓ visual index</div>
          </div>

          <!-- Row: query -->
          <div class="flex items-stretch gap-2">
            <div class="w-28 shrink-0 flex items-center">
              <span class="text-[10px] font-mono text-secondary">QUERY</span>
            </div>
            <div class="flex-1 grid grid-cols-3 gap-2">
              <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
                <div class="text-[10px] font-bold text-foreground mb-1">Text query</div>
                <div class="text-[9px] text-secondary">user question</div>
              </div>
              <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.06] p-3 text-center">
                <div class="text-[9px] font-mono text-violet-400 mb-1">TRAIN</div>
                <div class="text-[10px] font-bold text-foreground">Encoder Bridge</div>
                <div class="text-[9px] text-secondary mt-1">project → visual space</div>
              </div>
              <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
                <div class="text-[10px] font-bold text-foreground mb-1">Top-k pages</div>
                <div class="text-[9px] text-secondary">retrieved visuals</div>
              </div>
            </div>
          </div>

          <div class="flex justify-center">
            <div class="text-[10px] font-mono text-violet-400">↓ Query-Driven Distillation</div>
          </div>

          <!-- Row: compress + LLM -->
          <div class="flex items-stretch gap-2">
            <div class="w-28 shrink-0 flex items-center">
              <span class="text-[10px] font-mono text-secondary">ANSWER</span>
            </div>
            <div class="flex-1 grid grid-cols-3 gap-2">
              <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.06] p-3 text-center">
                <div class="text-[9px] font-mono text-violet-400 mb-1">TRAIN</div>
                <div class="text-[10px] font-bold text-foreground">Compressor</div>
                <div class="text-[9px] text-secondary mt-1">cross-attn · 256 → 16</div>
              </div>
              <div class="rounded-lg border border-violet-500/40 bg-violet-500/10 p-3 text-center">
                <div class="text-[10px] font-bold text-violet-400 mb-1">16 prefix toks</div>
                <div class="text-[9px] text-secondary">query-conditioned</div>
              </div>
              <div class="rounded-lg border border-yellow-500/25 bg-yellow-500/[0.04] p-3 text-center">
                <div class="text-[9px] font-mono text-yellow-400 mb-1">FROZEN</div>
                <div class="text-[10px] font-bold text-foreground">Qwen2.5-7B</div>
                <div class="text-[9px] text-secondary mt-1">Instruct · answers</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Mobile architecture -->
        <div class="md:hidden space-y-2">
          <div class="rounded-lg border border-border bg-[#161b22] p-3">
            <div class="text-[9px] font-mono text-secondary mb-1">01 · RENDER</div>
            <div class="text-xs font-bold text-foreground">Docs → page images → frozen DeepEncoder</div>
          </div>
          <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.04] p-3">
            <div class="text-[9px] font-mono text-violet-400 mb-1">02 · BRIDGE (TRAIN)</div>
            <div class="text-xs font-bold text-foreground">Text query projected into visual feature space</div>
          </div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3">
            <div class="text-[9px] font-mono text-secondary mb-1">03 · RETRIEVE</div>
            <div class="text-xs font-bold text-foreground">Top-k visual pages / tokens from the index</div>
          </div>
          <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.04] p-3">
            <div class="text-[9px] font-mono text-violet-400 mb-1">04 · DISTILL (TRAIN)</div>
            <div class="text-xs font-bold text-foreground">Cross-attn compressor: 256 → 16 prefix tokens</div>
          </div>
          <div class="rounded-lg border border-yellow-500/25 bg-yellow-500/[0.04] p-3">
            <div class="text-[9px] font-mono text-yellow-400 mb-1">05 · GENERATE (FROZEN)</div>
            <div class="text-xs font-bold text-foreground">Qwen2.5-7B-Instruct reads the 16-token prefix</div>
          </div>
        </div>
      </div>

      <!-- Frozen vs train legend -->
      <div class="grid grid-cols-2 gap-3 mb-2">
        <div class="rounded-xl border border-yellow-500/25 bg-yellow-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-yellow-400 font-bold mb-2">FROZEN (DO NOT TRAIN)</div>
          <ul class="text-[11px] text-foreground/70 space-y-1.5 mb-0 list-none pl-0">
            <li class="flex gap-2"><span class="text-yellow-400">→</span><span>DeepEncoder / ViT</span></li>
            <li class="flex gap-2"><span class="text-yellow-400">→</span><span>Qwen2.5-7B-Instruct</span></li>
          </ul>
        </div>
        <div class="rounded-xl border border-violet-500/30 bg-violet-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-violet-400 font-bold mb-2">TRAINABLE (SMALL)</div>
          <ul class="text-[11px] text-foreground/70 space-y-1.5 mb-0 list-none pl-0">
            <li class="flex gap-2"><span class="text-violet-400">→</span><span>Encoder Bridge projection</span></li>
            <li class="flex gap-2"><span class="text-violet-400">→</span><span>Query-Driven Distillation</span></li>
          </ul>
        </div>
      </div>
      <p class="text-[11px] text-secondary mt-3 mb-0">
        Plug-in stack: keep the backbone, train the bridge + compressor only. No expensive vision-language contrastive pretraining.
      </p>
    </div>

    <!-- Ingredient 1: Encoder-Bridged Retrieval -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-violet-400 font-mono text-sm">#</span> Ingredient 1: Encoder-Bridged Retrieval
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        The hard part of pixel RAG: the user types <strong>text</strong>, the index holds <strong>visual</strong> features. OpticalRAG does not train a CLIP-style dual encoder from scratch.
      </p>

      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5 mb-4">
        <div class="text-[10px] font-mono text-secondary mb-4">TEXT QUERY → VISUAL SPACE (NO CONTRASTIVE)</div>
        <div class="hidden md:grid grid-cols-5 gap-2 items-center">
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-[10px] font-bold text-foreground">"What is X?"</div>
            <div class="text-[9px] text-secondary mt-1">text query</div>
          </div>
          <div class="text-center text-[10px] font-mono text-violet-400">→ states</div>
          <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.06] p-3 text-center">
            <div class="text-[10px] font-bold text-foreground">Shared projection</div>
            <div class="text-[9px] text-secondary mt-1">same as compressor</div>
          </div>
          <div class="text-center text-[10px] font-mono text-violet-400">→ match</div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-[10px] font-bold text-foreground">Visual index</div>
            <div class="text-[9px] text-secondary mt-1">page features</div>
          </div>
        </div>
        <div class="md:hidden space-y-2">
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-[11px] text-foreground/80">Text query states</div>
          <div class="text-center text-[10px] font-mono text-violet-400">↓ shared projection (also used by compressor)</div>
          <div class="rounded-lg border border-violet-500/30 bg-violet-500/[0.06] p-3 text-[11px] text-foreground/80">Projected into frozen ViT feature space</div>
          <div class="text-center text-[10px] font-mono text-violet-400">↓ nearest neighbors</div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-[11px] text-foreground/80">Retrieved visual tokens / pages</div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-2">USUAL APPROACH</div>
          <p class="text-[11px] text-foreground/70 mb-0">Train contrastive text-image pairs so query and page live in one space. Expensive. Separate from the compressor.</p>
        </div>
        <div class="rounded-xl border border-violet-500/30 bg-violet-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-violet-400 font-bold mb-2">OPTICALRAG BRIDGE</div>
