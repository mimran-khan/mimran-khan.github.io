---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
---

<BaseLayout
  title="Meta Connect: Personal Superintelligence on a Keychain | Demystifying AI in 5 Minutes"
  description="Meta's Muse Charm is a 12g wearable AI companion with always-on audio, 72-hour local context, and Llama-5 inference at 3W. Announced at Meta Connect 2026."
  image="/og-series-ep40-meta-muse-charm.png"
  keywords="Meta Connect, Muse Charm, wearable AI, Llama-5, personal AI, edge inference, always-on AI, Meta AI"
  publishedDate="2026-10-08"
  articleSection="Demystifying AI"
  articleTags={["Meta Connect", "Muse Charm", "Wearable AI", "Llama-5", "Edge Inference", "Personal AI"]}
>

  <style>
    .stat-card { transition: all 0.3s ease; }
    .stat-card:hover { transform: scale(1.02); box-shadow: 0 0 20px rgba(139, 92, 246, 0.1); }
    .spec-card { transition: all 0.3s ease; }
    .spec-card:hover { transform: translateY(-2px); box-shadow: 0 0 15px rgba(139, 92, 246, 0.08); }
  </style>

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-violet/[0.04] via-background to-background"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(139,92,246,0.06)_0%,transparent_60%)]"></div>

    <div class="relative container-main max-w-4xl pt-20 pb-10">
      <a href="/series/demystifying-ai" class="inline-flex items-center gap-2 text-xs text-secondary hover:text-violet transition-colors mb-8 font-mono">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        cd ~/series/demystifying-ai
      </a>

      <div class="rounded-xl overflow-hidden border border-border mb-8">
        <img src="/series/ep40-meta-muse-charm.png" alt="Meta Connect: Personal Superintelligence on a Keychain" class="w-full h-auto block" />
      </div>

      <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-4">
        <span class="flex items-center gap-1.5 text-[10px] text-violet font-mono bg-violet/5 border border-violet/20 px-2 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-violet animate-pulse"></span>
          EP 40
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-1 text-[10px] font-mono bg-violet/10 border border-violet/20 text-violet rounded-full">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          RESEARCH PAPER
        </span>
        <span class="text-[10px] text-secondary font-mono">Oct 8, 2026</span>
        <span class="text-[10px] text-secondary font-mono">5 min</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">
        Meta Connect: Personal Superintelligence on a Keychain
      </h1>
      <p class="text-sm md:text-base text-secondary max-w-2xl mb-2">
        Meta announced Muse Charm at Connect 2026 — a 12-gram wearable that runs Llama-5 inference at 3 watts. Always-on ambient audio. 72-hour rolling context. No cloud required for core interactions.
      </p>

      <ShareButtons title="Meta Connect: Personal Superintelligence on a Keychain" url="/series/demystifying-ai/meta-muse-charm" />
    </div>
  </section>

  <article class="container-main max-w-4xl py-10">

    <!-- TL;DR -->
    <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-6 mb-10 max-w-3xl">
      <span class="text-xs font-mono text-violet font-bold">// TL;DR</span>
      <p class="text-sm text-foreground/90 leading-relaxed mt-3 mb-0">
        <strong>Muse Charm</strong> is a 12g keychain pendant with a custom MTIA-3 chip that runs a distilled <strong>Llama-5 Scout (17B MoE, 3.6B active)</strong> at 3W. It records ambient audio, maintains 72-hour local context, and can answer questions, take notes, and manage tasks without a phone connection. <strong>$149 with no subscription.</strong> Ships February 2027. The catch: always-on audio capture raises questions nobody at Connect answered.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10 max-w-3xl">
      <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-4 text-center stat-card">
        <div class="text-xl font-bold text-violet mb-1">12g</div>
        <div class="text-[10px] font-mono text-secondary">Weight</div>
      </div>
      <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-4 text-center stat-card">
        <div class="text-xl font-bold text-violet mb-1">3W</div>
        <div class="text-[10px] font-mono text-secondary">Inference Power</div>
      </div>
      <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-4 text-center stat-card">
        <div class="text-xl font-bold text-violet mb-1">72h</div>
        <div class="text-[10px] font-mono text-secondary">Rolling Context</div>
      </div>
      <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-4 text-center stat-card">
        <div class="text-xl font-bold text-violet mb-1">$149</div>
        <div class="text-[10px] font-mono text-secondary">No Subscription</div>
      </div>
    </div>

    <!-- Hardware -->
    <h2 class="text-lg font-bold text-foreground mb-6 flex items-center gap-2">
      <span class="text-violet font-mono text-sm">#</span> The Hardware
    </h2>

    <div class="rounded-xl border border-border bg-elevated p-5 mb-10 max-w-3xl">
      <div class="text-xs font-mono text-secondary mb-4">MUSE CHARM SPECS</div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Chip</span>
            <span class="text-foreground font-mono">MTIA-3 (custom)</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Model</span>
            <span class="text-foreground font-mono">Llama-5 Scout 17B MoE</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Active params</span>
            <span class="text-foreground font-mono">3.6B (4-bit quant)</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Memory</span>
            <span class="text-foreground font-mono">8 GB LPDDR5X</span>
          </div>
        </div>
        <div class="space-y-2">
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Battery</span>
            <span class="text-foreground font-mono">18h active / 5 days standby</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Audio</span>
            <span class="text-foreground font-mono">3-mic array, bone conduction</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Connectivity</span>
            <span class="text-foreground font-mono">BLE 5.4, Wi-Fi 7, UWB</span>
          </div>
          <div class="flex justify-between text-xs">
            <span class="text-foreground/60">Storage</span>
            <span class="text-foreground font-mono">64 GB (encrypted)</span>
          </div>
        </div>
      </div>
    </div>

    <!-- How it works -->
    <h2 class="text-lg font-bold text-foreground mb-6 flex items-center gap-2">
      <span class="text-violet font-mono text-sm">#</span> How the 72-Hour Context Works
    </h2>

    <p class="text-sm text-foreground/80 leading-relaxed mb-4 max-w-3xl">
      Muse Charm continuously records ambient audio, runs real-time speech-to-text on-device, and builds a <strong>rolling 72-hour context window</strong>. Audio is never stored raw — only the transcribed text and extracted semantic embeddings persist. After 72 hours, old context is summarized into compressed memory nodes.
    </p>

    <div class="space-y-3 mb-10 max-w-3xl">
      <div class="rounded-xl border border-border bg-elevated p-4 spec-card">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-mono text-violet bg-violet/10 px-2 py-1 rounded font-bold">LOCAL</span>
          <span class="text-xs font-bold text-foreground">Core interactions</span>
        </div>
        <p class="text-[11px] text-foreground/60">Questions, reminders, note-taking, calendar, and task management all run locally on the MTIA-3 chip. No network needed.</p>
      </div>
      <div class="rounded-xl border border-border bg-elevated p-4 spec-card">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-mono text-violet bg-violet/10 px-2 py-1 rounded font-bold">CLOUD</span>
          <span class="text-xs font-bold text-foreground">Complex reasoning</span>
        </div>
        <p class="text-[11px] text-foreground/60">Deep research, image generation, and multi-step agentic tasks route to Llama-5 Maverick (128B) in Meta's cloud. Local context is sent as a compressed summary.</p>
      </div>
      <div class="rounded-xl border border-border bg-elevated p-4 spec-card">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] font-mono text-violet bg-violet/10 px-2 py-1 rounded font-bold">HYBRID</span>
          <span class="text-xs font-bold text-foreground">Adaptive routing</span>
        </div>
        <p class="text-[11px] text-foreground/60">The device estimates query complexity and routes accordingly. Under 100ms for local responses. 2-4 seconds for cloud offload.</p>
      </div>
    </div>

    <!-- Privacy Concerns -->
    <h2 class="text-lg font-bold text-foreground mb-6 flex items-center gap-2">
      <span class="text-violet font-mono text-sm">#</span> The Privacy Questions Nobody Asked
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-10 max-w-3xl">
      <div class="rounded-xl border border-red-500/20 bg-red-500/[0.03] p-4 spec-card">
        <span class="text-xs font-bold text-red-400 block mb-2">Always-on audio</span>
        <p class="text-[11px] text-foreground/60">The device records everything around you. Even if audio is "only transcribed locally," that transcription captures everyone nearby — with or without consent.</p>
      </div>
      <div class="rounded-xl border border-red-500/20 bg-red-500/[0.03] p-4 spec-card">
        <span class="text-xs font-bold text-red-400 block mb-2">Cloud escalation path</span>
        <p class="text-[11px] text-foreground/60">Complex queries send compressed context summaries to Meta's servers. What counts as "complex"? The device decides. User has no per-query approval.</p>
      </div>
      <div class="rounded-xl border border-red-500/20 bg-red-500/[0.03] p-4 spec-card">
        <span class="text-xs font-bold text-red-400 block mb-2">$149, no subscription</span>
        <p class="text-[11px] text-foreground/60">If you're not paying a subscription, the business model is either hardware margin (thin at $149) or data monetization. Meta's history suggests the latter.</p>
      </div>
      <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-4 spec-card">
        <span class="text-xs font-bold text-violet block mb-2">Meta's counter</span>
        <p class="text-[11px] text-foreground/60">End-to-end encryption. On-device processing by default. No raw audio leaves the device. Context encrypted at rest with user biometrics. Open-source Llama-5 model weights.</p>
      </div>
    </div>

    <!-- Bottom Line -->
    <div class="rounded-xl border border-violet/20 bg-violet/[0.03] p-6 max-w-3xl mb-10">
      <span class="text-xs font-mono text-violet font-bold">// Bottom Line</span>
      <p class="text-sm text-foreground/90 leading-relaxed mt-3 mb-0">
        <strong>Muse Charm is the most compelling AI hardware since AirPods.</strong> A 12-gram pendant that genuinely understands your day because it was there for all of it. The on-device inference is real — 3.6B active parameters at 3W is a silicon achievement. But "always-on audio capture" and "Meta" in the same sentence will make anyone pause. <strong>The product is amazing. The company making it is the reason you'll hesitate.</strong>
      </p>
    </div>

    <!-- Next Episode -->
    <div class="max-w-3xl border-t border-border pt-8 mt-8">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-[10px] font-mono text-secondary">NEXT EPISODE</span>
        <div class="flex-1 h-px bg-border"></div>
        <span class="text-[10px] font-mono text-secondary">Saturday</span>
      </div>
      <div class="rounded-xl border border-dashed border-violet/30 bg-violet/[0.02] p-5">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-mono text-violet font-bold">#41</span>
          <span class="px-2 py-0.5 text-[9px] font-mono bg-yellow-500/10 border border-yellow-500/20 text-yellow-400 rounded">Upcoming</span>
        </div>
        <h3 class="text-base font-semibold text-foreground/70 mb-1">Atria Dawn: 744B Open-Weight Agentic Superintelligence</h3>
        <p class="text-xs text-secondary/70">Mistral's largest open-weight model. 744B parameters. 256K context. SWE-bench Verified 62.1%. Apache 2.0.</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="max-w-3xl mt-10 flex flex-col sm:flex-row items-center justify-between gap-4 p-5 rounded-xl border border-border bg-elevated">
      <div>
        <p class="text-sm font-semibold text-foreground mb-0.5">Enjoyed this?</p>
        <p class="text-xs text-secondary">New episodes Mon, Wed, Sat.</p>
      </div>
      <div class="flex items-center gap-3">
        <a href="/series/demystifying-ai" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border border-border text-xs text-secondary hover:text-violet hover:border-violet/30 transition-colors">All Episodes</a>
        <a href="https://www.linkedin.com/in/mohdimran-khan/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-violet/10 border border-violet/20 text-xs text-violet hover:bg-violet/20 transition-colors">
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          Follow
        </a>
      </div>
    </div>

  </article>

</BaseLayout>
