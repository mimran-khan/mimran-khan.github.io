---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ShareButtons from '../../../components/ShareButtons.astro';
import NextEpisodeTeaser from '../../../components/NextEpisodeTeaser.astro';
---

<BaseLayout
  title="Claude Fable 5.2: The Frontier Coding Model | Demystifying AI in 5 Minutes"
  description="Anthropic shipped Claude Fable 5.2 on Nov 9 - 69.9% FrontierSWE v2, 89.3% OSWorld 2.1 offline partial, 20% cheaper than Fable 5.1. Hardest public Claude for long-horizon work - not the daily driver."
  image="/og-series-ep60-claude-fable-52.png"
  keywords="Claude Fable 5.2, Anthropic, FrontierSWE, OSWorld, Mythos 5.2, Opus 5.5, coding model, agentic AI, Claude API"
  publishedDate="2026-11-21"
  articleSection="Demystifying AI"
  articleTags={["Claude Fable 5.2", "Anthropic", "FrontierSWE", "OSWorld", "Coding Model", "New Release"]}
>

  <style>
    .stat-card { transition: all 0.3s ease; }
    .stat-card:hover { transform: scale(1.02); box-shadow: 0 0 20px rgba(34, 211, 238, 0.12); }
    .viz-card { transition: all 0.3s ease; }
    .viz-card:hover { transform: translateY(-2px); box-shadow: 0 0 16px rgba(34, 211, 238, 0.1); }
    .bar-fill { transition: width 0.6s ease; }
  </style>

  <section class="relative overflow-hidden border-b border-border">
    <div class="absolute inset-0 bg-gradient-to-b from-cyan-500/[0.04] via-background to-background"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,rgba(34,211,238,0.06)_0%,transparent_60%)]"></div>

    <div class="relative container-main max-w-4xl pt-20 pb-10">
      <a href="/series/demystifying-ai" class="inline-flex items-center gap-2 text-xs text-secondary hover:text-cyan-400 transition-colors mb-8 font-mono">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        cd ~/series/demystifying-ai
      </a>

      <div class="rounded-xl overflow-hidden border border-border mb-8">
        <img src="/series/ep60-claude-fable-52.png" alt="Claude Fable 5.2: The Frontier Coding Model" class="w-full h-auto block" />
      </div>

      <div class="flex flex-wrap items-center gap-2 md:gap-3 mb-4">
        <span class="flex items-center gap-1.5 text-[10px] text-cyan-400 font-mono bg-cyan-500/5 border border-cyan-500/20 px-2 py-1 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
          EP 60
        </span>
        <span class="inline-flex items-center gap-1 px-2 py-1 text-[10px] font-mono bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 rounded-full">
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
          NEW RELEASE
        </span>
        <a href="https://www.anthropic.com/claude-fable-and-mythos-5-2" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 px-2 py-1 text-[10px] font-mono bg-cyan-500/10 border border-cyan-500/20 text-cyan-400 rounded-full hover:bg-cyan-500/20 transition-colors">
          Anthropic launch
          <svg class="w-2.5 h-2.5 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
        </a>
        <span class="text-[10px] text-secondary font-mono">Nov 21, 2026</span>
        <span class="text-[10px] text-secondary font-mono">5 min</span>
      </div>

      <h1 class="text-2xl md:text-3xl font-bold text-foreground leading-tight mb-3">
        Claude Fable 5.2: The Frontier Coding Model
      </h1>
      <p class="text-sm md:text-base text-secondary max-w-2xl mb-2">
        Anthropic's hardest public model for long-horizon agentic work - 69.9% FrontierSWE v2, 20% cheaper than 5.1. Still not the default. Opus 5.5 is.
      </p>

      <ShareButtons title="Claude Fable 5.2: The Frontier Coding Model" url="/series/demystifying-ai/claude-fable-52" />
    </div>
  </section>

  <article class="container-main max-w-4xl py-8 md:py-10 overflow-hidden">

    <!-- TL;DR -->
    <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/[0.03] p-4 md:p-6 mb-8 md:mb-10 max-w-3xl">
      <span class="text-xs font-mono text-cyan-400 font-bold">// TL;DR</span>
      <p class="text-sm text-foreground/90 leading-relaxed mt-3 mb-0">
        On <strong>Nov 9, 2026</strong>, Anthropic shipped <strong>Claude Fable 5.2</strong> (and twin <strong>Mythos 5.2</strong>). Model ID <code class="text-xs">claude-fable-5-2</code>. Headline benches: <strong>69.9%</strong> FrontierSWE v2 (vs 56.3% on 5.1) and <strong>89.3%</strong> OSWorld 2.1 offline with partial credit (strict pass <strong>54.6%</strong>). Price drops <strong>20%</strong> to <strong>$8 / $40</strong> per MTok. Anthropic still says: start on <strong>Opus 5.5</strong>, escalate to Fable when evals fail.
      </p>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-8 md:mb-10 max-w-3xl">
      <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-cyan-400 mb-1">69.9%</div>
        <div class="text-[10px] font-mono text-secondary">FrontierSWE v2</div>
      </div>
      <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-cyan-400 mb-1">89.3%</div>
        <div class="text-[10px] font-mono text-secondary">OSWorld offline partial</div>
      </div>
      <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-cyan-400 mb-1">-20%</div>
        <div class="text-[10px] font-mono text-secondary">vs Fable 5.1 price</div>
      </div>
      <div class="rounded-xl border border-cyan-500/20 bg-cyan-500/[0.03] p-4 text-center stat-card">
        <div class="text-xl md:text-2xl font-bold text-cyan-400 mb-1">1M</div>
        <div class="text-[10px] font-mono text-secondary">Context window</div>
      </div>
    </div>

    <!-- What shipped -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-sm">#</span> What Shipped on Nov 9
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        Two names. Same hard tier. Different gates.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-5">
        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-cyan-400 font-bold mb-2">CLAUDE FABLE 5.2</div>
          <ul class="text-[11px] text-foreground/70 space-y-1.5 mb-0 list-none pl-0">
            <li class="flex gap-2"><span class="text-cyan-400">→</span><span>Public API: <code class="text-[10px]">claude-fable-5-2</code></span></li>
            <li class="flex gap-2"><span class="text-cyan-400">→</span><span>Cyber / bio safeguards kept on</span></li>
            <li class="flex gap-2"><span class="text-cyan-400">→</span><span>Cyber tasks mostly blocked</span></li>
            <li class="flex gap-2"><span class="text-cyan-400">→</span><span>Successor to Fable 5.1</span></li>
          </ul>
        </div>
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-2">CLAUDE MYTHOS 5.2</div>
          <ul class="text-[11px] text-foreground/70 space-y-1.5 mb-0 list-none pl-0">
            <li class="flex gap-2"><span class="text-secondary">→</span><span>Same weights, fewer safeguards</span></li>
            <li class="flex gap-2"><span class="text-secondary">→</span><span>Gated: Life Sciences + Cyber Verification</span></li>
            <li class="flex gap-2"><span class="text-secondary">→</span><span>Not the default public path</span></li>
            <li class="flex gap-2"><span class="text-secondary">→</span><span>Mention it; do not treat as open access</span></li>
          </ul>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5">
        <div class="text-[10px] font-mono text-secondary mb-3">CORE SPECS (FABLE 5.2)</div>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-sm font-bold text-cyan-400">1M</div>
            <div class="text-[9px] font-mono text-secondary mt-1">context</div>
          </div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-sm font-bold text-cyan-400">128K</div>
            <div class="text-[9px] font-mono text-secondary mt-1">max out</div>
          </div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-sm font-bold text-cyan-400">high</div>
            <div class="text-[9px] font-mono text-secondary mt-1">default effort</div>
          </div>
          <div class="rounded-lg border border-border bg-[#161b22] p-3 text-center">
            <div class="text-sm font-bold text-cyan-400">Jun 2026</div>
            <div class="text-[9px] font-mono text-secondary mt-1">knowledge cutoff</div>
          </div>
        </div>
        <p class="text-[10px] text-secondary mt-3 mb-0">Adaptive thinking always on. Optional fast mode: up to ~2.5x token speed at $16 / $80 per MTok. Anthropic also claims up to ~30% faster generation vs Fable 5.1 on standard mode.</p>
      </div>
    </div>

    <!-- Stack position architecture -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-sm">#</span> Where Fable Sits in the Stack
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        The launch post is not "replace everything with Fable." It is a <strong>ladder</strong>.
      </p>

      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5 mb-4">
        <div class="text-[10px] font-mono text-secondary mb-4">ANTHROPIC ROUTING (SIMPLIFIED)</div>
        <div class="space-y-2">
          <div class="rounded-lg border border-border bg-[#161b22] px-3 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <div class="text-xs font-bold text-foreground">Sonnet / Haiku 5.5</div>
              <div class="text-[10px] text-secondary">cheap, fast, high volume</div>
            </div>
            <span class="text-[9px] font-mono text-secondary border border-border rounded px-2 py-0.5 w-fit">COST FIRST</span>
          </div>
          <div class="flex justify-center text-[10px] font-mono text-cyan-400">↓ most work starts here</div>
          <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/[0.04] px-3 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <div class="text-xs font-bold text-foreground">Claude Opus 5.5</div>
              <div class="text-[10px] text-secondary">daily driver for coding agents</div>
            </div>
            <span class="text-[9px] font-mono text-cyan-400 border border-cyan-500/30 rounded px-2 py-0.5 w-fit">DEFAULT</span>
          </div>
          <div class="flex justify-center text-[10px] font-mono text-cyan-400">↓ escalate when evals still fail</div>
          <div class="rounded-lg border border-cyan-500/40 bg-cyan-500/10 px-3 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <div class="text-xs font-bold text-cyan-400">Claude Fable 5.2</div>
              <div class="text-[10px] text-secondary">hardest public tier · long-horizon agentic / technical</div>
            </div>
            <span class="text-[9px] font-mono text-cyan-400 border border-cyan-500/40 rounded px-2 py-0.5 w-fit">ESCALATION</span>
          </div>
          <div class="flex justify-center text-[10px] font-mono text-secondary">↓ verification programs only</div>
          <div class="rounded-lg border border-border bg-[#161b22] px-3 py-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <div>
              <div class="text-xs font-bold text-foreground">Claude Mythos 5.2</div>
              <div class="text-[10px] text-secondary">same model · fewer cyber/bio rails · gated</div>
            </div>
            <span class="text-[9px] font-mono text-secondary border border-border rounded px-2 py-0.5 w-fit">GATED</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        <div class="rounded-xl border border-cyan-500/25 bg-cyan-500/[0.03] p-4 viz-card">
          <div class="text-[10px] font-mono text-cyan-400 font-bold mb-2">USE FABLE AS</div>
          <p class="text-[11px] text-foreground/70 mb-0">Advisor on hard failures, or Orchestrator on multi-hour agent runs that Opus cannot close.</p>
        </div>
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-2">DO NOT USE FABLE AS</div>
          <p class="text-[11px] text-foreground/70 mb-0">The default autocomplete / every PR bot. Price and latency still favor Opus for most traffic.</p>
        </div>
      </div>
    </div>

    <!-- Benchmarks -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-sm">#</span> The Numbers That Matter
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        All figures below are from Anthropic's launch table unless noted. Treat competitor comparisons as vendor-reported.
      </p>

      <!-- FrontierSWE bars -->
      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5 mb-5">
        <div class="text-[10px] font-mono text-secondary mb-4">FRONTIERSWE V2</div>
        <div class="space-y-3">
          <div>
            <div class="flex justify-between text-[11px] mb-1">
              <span class="text-cyan-400 font-bold">Fable 5.2</span>
              <span class="font-mono text-cyan-400">69.9%</span>
            </div>
            <div class="h-3 rounded-full bg-border overflow-hidden">
              <div class="bar-fill h-full rounded-full bg-cyan-400" style="width:100%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-[11px] mb-1">
              <span class="text-foreground/80">Opus 5.5 (Anthropic table)</span>
              <span class="font-mono text-secondary">62.3%</span>
            </div>
            <div class="h-3 rounded-full bg-border overflow-hidden">
              <div class="bar-fill h-full rounded-full bg-cyan-400/50" style="width:89%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-[11px] mb-1">
              <span class="text-foreground/80">Fable 5.1</span>
              <span class="font-mono text-secondary">56.3%</span>
            </div>
            <div class="h-3 rounded-full bg-border overflow-hidden">
              <div class="bar-fill h-full rounded-full bg-secondary/40" style="width:80.5%"></div>
            </div>
          </div>
        </div>
        <p class="text-[10px] text-secondary mt-3 mb-0">Bar widths relative to Fable 5.2. This is the cleanest headline lift: +13.6 pts vs 5.1.</p>
      </div>

      <!-- OSWorld caveat visual -->
      <div class="rounded-xl border border-border bg-elevated p-4 md:p-5 mb-5">
        <div class="text-[10px] font-mono text-secondary mb-4">OSWORLD 2.1 · READ THE LABEL</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-3">
          <div class="rounded-lg border border-cyan-500/30 bg-cyan-500/[0.06] p-4 text-center">
            <div class="text-2xl font-bold text-cyan-400 mb-1">89.3%</div>
            <div class="text-[10px] font-mono text-cyan-400">offline · partial credit</div>
            <div class="text-[9px] text-secondary mt-2">Fable 5.1 was 83.5% on same framing</div>
          </div>
          <div class="rounded-lg border border-yellow-500/25 bg-yellow-500/[0.04] p-4 text-center">
            <div class="text-2xl font-bold text-yellow-400 mb-1">54.6%</div>
            <div class="text-[10px] font-mono text-yellow-400">strict pass (system card)</div>
            <div class="text-[9px] text-secondary mt-2">Same model · harder scoring</div>
          </div>
        </div>
        <p class="text-[11px] text-secondary mb-0">
          Do not tweet bare "89.3% OSWorld." Always say <strong>offline subset + partial credit</strong>, or cite the strict number next to it.
        </p>
      </div>

      <!-- More benches table -->
      <div class="rounded-xl border border-border overflow-hidden mb-2 hidden md:block">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-elevated text-left">
              <th class="px-4 py-3 text-[10px] font-mono text-secondary">Bench</th>
              <th class="px-4 py-3 text-[10px] font-mono text-secondary">Fable 5.2</th>
              <th class="px-4 py-3 text-[10px] font-mono text-secondary">Fable 5.1</th>
              <th class="px-4 py-3 text-[10px] font-mono text-secondary">Delta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <td class="px-4 py-3 text-xs font-bold text-foreground">FrontierSWE v2</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">69.9%</td>
              <td class="px-4 py-3 font-mono text-secondary text-xs">56.3%</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">+13.6</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-xs font-bold text-foreground">FrontierCode 2.0 (Xhigh)</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">49.1%</td>
              <td class="px-4 py-3 font-mono text-secondary text-xs">32.4%</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">+16.7</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-xs font-bold text-foreground">HLE (with tools)</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">74.2%</td>
              <td class="px-4 py-3 font-mono text-secondary text-xs">65.6%</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">+8.6</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-xs font-bold text-foreground">RLI (High effort)</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">41.3%</td>
              <td class="px-4 py-3 font-mono text-secondary text-xs">17.9%</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">+23.4</td>
            </tr>
            <tr>
              <td class="px-4 py-3 text-xs font-bold text-foreground">Terminal-Bench-Science 0.1</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">74.6%</td>
              <td class="px-4 py-3 font-mono text-secondary text-xs">52.6%</td>
              <td class="px-4 py-3 font-mono text-cyan-400 text-xs">+22.0</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="md:hidden space-y-2 mb-2">
        <div class="rounded-lg border border-cyan-500/25 bg-cyan-500/[0.03] p-3">
          <div class="text-[10px] font-mono text-cyan-400 mb-1">FRONTIERCODE 2.0 XHIGH · 49.1%</div>
          <p class="text-[11px] text-secondary mb-0">Was 32.4% on 5.1 (+16.7).</p>
        </div>
        <div class="rounded-lg border border-border p-3">
          <div class="text-[10px] font-mono text-cyan-400 mb-1">HLE + TOOLS · 74.2%</div>
          <p class="text-[11px] text-secondary mb-0">Was 65.6% on 5.1.</p>
        </div>
        <div class="rounded-lg border border-border p-3">
          <div class="text-[10px] font-mono text-cyan-400 mb-1">RLI HIGH · 41.3%</div>
          <p class="text-[11px] text-secondary mb-0">Was 17.9% - biggest relative jump in the set.</p>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div class="max-w-3xl mb-10 md:mb-12">
      <h2 class="text-lg font-bold text-foreground mb-3 flex items-center gap-2">
        <span class="text-cyan-400 font-mono text-sm">#</span> The 20% Price Cut Is Exact
      </h2>
      <p class="text-sm text-secondary leading-relaxed mb-5">
        Base API. Both sides drop by the same fraction.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-4">
        <div class="rounded-xl border border-border bg-elevated p-4 viz-card">
          <div class="text-[10px] font-mono text-secondary font-bold mb-3">FABLE 5.1</div>
          <div class="flex justify-between items-end mb-1">
            <span class="text-[11px] text-secondary">Input / MTok</span>
            <span class="text-lg font-bold text-foreground">$10</span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-[11px] text-secondary">Output / MTok</span>
            <span class="text-lg font-bold text-foreground">$50</span>
          </div>
        </div>
        <div class="rounded-xl border border-cyan-500/30 bg-cyan-500/[0.04] p-4 viz-card">
          <div class="text-[10px] font-mono text-cyan-400 font-bold mb-3">FABLE 5.2</div>
          <div class="flex justify-between items-end mb-1">
            <span class="text-[11px] text-secondary">Input / MTok</span>
            <span class="text-lg font-bold text-cyan-400">$8</span>
          </div>
          <div class="flex justify-between items-end">
            <span class="text-[11px] text-secondary">Output / MTok</span>
            <span class="text-lg font-bold text-cyan-400">$40</span>
          </div>
        </div>
      </div>

      <div class="rounded-xl border border-border bg-elevated p-4">
