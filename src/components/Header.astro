---
const navLinks = [
  { href: '/#research', label: 'Publications' },
  { href: '/#experience', label: 'Experience' },
  { href: '/series/demystifying-ai', label: 'Series' },
  { href: '/#blog', label: 'Blog' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#contact', label: 'Contact' },
  { href: '/beyond-code', label: 'Beyond Code' },
];

const topmateUrl = 'https://topmate.io/mohdimran_khan';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-background/95 backdrop-blur-sm border-b border-border">
  <nav class="container-main flex items-center justify-between h-14">
    <a href="/" id="logo-link" class="font-mono text-green hover:text-green-dim transition-colors cursor-pointer relative z-10 py-2 no-underline" onclick="if(window.location.pathname==='/'||window.location.pathname==='/index.html'){event.preventDefault();window.scrollTo({top:0,behavior:'smooth'});}else{window.location.href='/';}">
      <span id="logo-text">~/imran-khan</span>
    </a>
    
    <div class="flex items-center gap-1">
      <ul class="hidden md:flex items-center gap-1">
        {navLinks.map(({ href, label }) => (
          <li>
            <a 
              href={href} 
              class="px-3 py-1.5 text-small text-secondary hover:text-green transition-colors"
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
      
      <a 
        href={topmateUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:flex btn btn-primary text-small py-1.5 px-3 ml-4"
      >
        Book a Call
      </a>
      
      <button 
        id="mobile-menu-toggle"
        class="md:hidden p-2 text-secondary hover:text-green transition-colors"
        aria-label="Toggle menu"
      >
        <svg id="menu-open-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-close-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>
  
  <div id="mobile-menu" class="hidden md:hidden bg-background border-b border-border">
    <ul class="container-main py-4 space-y-1">
      {navLinks.map(({ href, label }) => (
        <li>
          <a 
            href={href} 
            class="block py-2 text-secondary hover:text-green transition-colors"
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-2">
        <a 
          href={topmateUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full btn btn-primary text-center text-small"
        >
          Book a Call
        </a>
      </li>
    </ul>
  </div>
</header>

<script is:inline>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-open-icon');
  const closeIcon = document.getElementById('menu-close-icon');
  
  toggle?.addEventListener('click', () => {
    const isHidden = menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden', !isHidden);
    closeIcon?.classList.toggle('hidden', isHidden);
  });
  
  document.querySelectorAll('#mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });

  // Text scramble effect for logo
  const logoText = document.getElementById('logo-text');
  if (logoText) {
    const names = ['imran-khan', 'mimran-khan', 'predatorroxy'];
    let nameIndex = 0;
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789@#$%&*<>[]{}|';
    
    let phase = 'hold';
    let revealIndex = 0;
    let holdCount = 0;
    
    const getCurrentText = () => `~/${names[nameIndex]}`;
    
    setInterval(() => {
      const currentText = getCurrentText();
      
      if (phase === 'scramble') {
        logoText.textContent = currentText
          .split('')
          .map((char) => {
            if (char === ' ' || char === '/' || char === '~') return char;
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join('');
        
        holdCount++;
        if (holdCount > 40) {
          phase = 'reveal';
          revealIndex = 0;
          holdCount = 0;
        }
      } else if (phase === 'reveal') {
        logoText.textContent = currentText
          .split('')
          .map((char, i) => {
            if (char === ' ' || char === '/' || char === '~') return char;
            if (i < revealIndex) return currentText[i];
            return chars[Math.floor(Math.random() * chars.length)];
          })
          .join('');
        
        revealIndex += 0.5;
        if (revealIndex >= currentText.length) {
          phase = 'hold';
          holdCount = 0;
        }
      } else if (phase === 'hold') {
        logoText.textContent = currentText;
        holdCount++;
        if (holdCount > 100) {
          nameIndex = (nameIndex + 1) % names.length;
          phase = 'scramble';
          holdCount = 0;
        }
      }
    }, 50);
  }
</script>
