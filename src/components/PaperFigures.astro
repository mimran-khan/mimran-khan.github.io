---
interface Figure {
  id: string;
  src: string;
  title: string;
  caption: string;
}

interface Props {
  figures: Figure[];
  accent?: 'violet' | 'cyan';
}

const { figures, accent = 'violet' } = Astro.props;
const accentText = accent === 'cyan' ? 'text-cyan' : 'text-violet-400';
---

<div data-paper-figures>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
    {figures.map((fig) => (
      <figure class="group flex flex-col rounded-xl border border-border bg-elevated overflow-hidden">
        <div class="px-3 py-2 border-b border-border bg-background/40">
          <p class={`text-[10px] font-mono ${accentText}`}>{fig.id}</p>
          <h3 class="text-[12px] sm:text-[13px] font-semibold text-foreground leading-snug line-clamp-2">{fig.title}</h3>
        </div>

        <button
          type="button"
          class="flex-1 block w-full bg-white p-2 sm:p-2.5 text-left cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-green/50"
          data-fig-open
          data-fig-src={fig.src}
          data-fig-caption={`${fig.id}. ${fig.caption}`}
          aria-label={`Enlarge ${fig.id}: ${fig.title}`}
        >
          <img
            src={fig.src}
            alt={`${fig.id}. ${fig.title}`}
            class="w-full h-auto max-h-44 sm:max-h-52 object-contain rounded-sm"
            loading="lazy"
            decoding="async"
          />
        </button>

        <figcaption class="px-3 py-2 border-t border-border">
          <p class="text-[11px] text-secondary leading-snug line-clamp-2">
            <span class={`font-mono ${accentText}`}>{fig.id}.</span> {fig.caption}
          </p>
        </figcaption>
      </figure>
    ))}
  </div>

  <!-- lightbox -->
  <div
    data-fig-lightbox
    class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/85 p-4 sm:p-8"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged figure"
  >
    <button type="button" data-fig-close class="absolute inset-0 cursor-zoom-out" aria-label="Close"></button>
    <div class="relative z-10 max-w-5xl w-full max-h-full overflow-auto rounded-xl bg-white p-3 sm:p-4 shadow-2xl">
      <img data-fig-lb-img src="" alt="" class="w-full h-auto" />
      <p data-fig-lb-cap class="mt-3 text-[12px] text-[#24292f] leading-relaxed"></p>
      <button
        type="button"
        data-fig-close
        class="absolute top-2 right-2 w-8 h-8 rounded-full bg-[#0d1117] text-white text-sm flex items-center justify-center"
        aria-label="Close figure"
      >×</button>
    </div>
  </div>
</div>

<script>
  function bootFigures() {
    const root = document.querySelector('[data-paper-figures]');
    if (!root || (root as HTMLElement).dataset.ready === '1') return;
    (root as HTMLElement).dataset.ready = '1';

    const lb = root.querySelector('[data-fig-lightbox]') as HTMLElement | null;
    const img = root.querySelector('[data-fig-lb-img]') as HTMLImageElement | null;
    const cap = root.querySelector('[data-fig-lb-cap]') as HTMLElement | null;
    if (!lb || !img || !cap) return;

    const open = (src: string, caption: string) => {
      img.src = src;
      img.alt = caption;
      cap.textContent = caption;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
      img.src = '';
    };

    root.querySelectorAll<HTMLElement>('[data-fig-open]').forEach((btn) => {
      btn.addEventListener('click', () => open(btn.dataset.figSrc || '', btn.dataset.figCaption || ''));
    });
    root.querySelectorAll('[data-fig-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lb.classList.contains('hidden')) close();
    });
  }

  bootFigures();
  document.addEventListener('astro:page-load', bootFigures);
</script>
